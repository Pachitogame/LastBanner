{
  "name": "last-banner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check": "tsc --noEmit",
    "test:ui": "tsx scripts/ui-check.ts",
    "format": "prettier --write src test scripts public"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
